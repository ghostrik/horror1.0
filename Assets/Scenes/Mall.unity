  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 52f0b1ccf04d78775ada72c085992d6b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  order: 0
  title: "\u0421\u043B\u0443\u0436\u0435\u0431\u043D\u0430\u044F \u0437\u0430\u043F\u0438\u0441\u043A\u0430 \u211647"
  prompt: "[E] \u041F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C"
  body: "\u0410\u0434\u043C\u0438\u043D\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u0438 \u0422\u0426 \u00AB\u0413\u0430\u043B\u0430\u043A\u0442\u0438\u043A\u0430\u00BB.\n\n\u041F\u0440\u043E\u043C\u043E\u0443\u0442\u0435\u0440-3 (\u0430\u043D\u0438\u043C\u0430\u0442\u0440\u043E\u043D\u0438\u043A \u0443 \u0432\u0445\u043E\u0434\u0430 \u0432 \u00AB\u041A\u043E\u0440\u0437\u0438\u043D\u0443\u00BB) \u043E\u043F\u044F\u0442\u044C \u0443\u0448\u0451\u043B \u0441 \u0442\u043E\u0447\u043A\u0438 \u043F\u043E\u0441\u043B\u0435 \u0437\u0430\u043A\u0440\u044B\u0442\u0438\u044F. \u041E\u0445\u0440\u0430\u043D\u0430 \u043D\u0430\u0448\u043B\u0430 \u0435\u0433\u043E \u0432 \u043F\u043E\u0434\u0441\u043E\u0431\u043A\u0435: \u0441\u0442\u043E\u044F\u043B \u043B\u0438\u0446\u043E\u043C \u043A \u0441\u0442\u0435\u043D\u0435 \u0438 \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u043B \u043F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0435.\n\n\u041F\u0440\u043E\u0448\u0443 \u043E\u0431\u0435\u0441\u0442\u043E\u0447\u0438\u0442\u044C \u043C\u043E\u0434\u0443\u043B\u044C.\n\n\u041F\u0440\u0438\u043F\u0438\u0441\u043A\u0430 \u0434\u0440\u0443\u0433\u0438\u043C \u043F\u043E\u0447\u0435\u0440\u043A\u043E\u043C: \u00AB\u041E\u0431\u0435\u0441\u0442\u043E\u0447\u0438\u043B\u0438. \u0422\u0430\u0431\u043B\u043E \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E \u0441\u0432\u0435\u0442\u0438\u0442\u0441\u044F.\u00BB"
