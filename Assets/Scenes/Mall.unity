  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 52f0b1ccf04d78775ada72c085992d6b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  order: 0
  title: "\u0427\u0435\u043A. \u041A\u043E\u0444\u0435\u0439\u043D\u044F \u00AB\u0411\u043E\u0434\u0440\u043E\u0441\u0442\u044C\u00BB"
  prompt: "[E] \u041F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C"
  body: "\u0422\u0426 \u00AB\u0413\u0410\u041B\u0410\u041A\u0422\u0418\u041A\u0410\u00BB \u00B7 \u043A\u043E\u0444\u0435\u0439\u043D\u044F \u00AB\u0411\u043E\u0434\u0440\u043E\u0441\u0442\u044C\u00BB\n14.11.2019  21:52\n\n\u041A\u0430\u043F\u0443\u0447\u0438\u043D\u043E 0,4 ........ 1 \u0448\u0442.\n\u041C\u0430\u0444\u0444\u0438\u043D ................ 1 \u0448\u0442.\n\n\u0421\u043F\u0430\u0441\u0438\u0431\u043E \u0437\u0430 \u043F\u043E\u043A\u0443\u043F\u043A\u0443!\n\u0412\u0430\u0448 \u043F\u0440\u043E\u043C\u043E\u0443\u0442\u0435\u0440 \u0432\u0441\u0435\u0433\u0434\u0430 \u0440\u044F\u0434\u043E\u043C :)\n\n\u041D\u0430 \u043E\u0431\u043E\u0440\u043E\u0442\u0435, \u0440\u0443\u0447\u043A\u043E\u0439, \u043A\u0440\u0438\u0432\u043E:\n\u00AB\u043E\u043D \u043F\u0440\u043E\u0441\u0442\u043E\u044F\u043B \u0443 \u043D\u0430\u0448\u0435\u0439 \u0432\u0438\u0442\u0440\u0438\u043D\u044B \u0432\u0435\u0441\u044C \u0432\u0435\u0447\u0435\u0440. \u043D\u0435 \u043C\u043E\u0440\u0433\u0430\u043B. \u0443 \u043D\u0435\u0433\u043E \u043D\u0435\u0442 \u0432\u0435\u043A, \u044F \u0437\u043D\u0430\u044E. \u043D\u043E \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E\u00BB"
