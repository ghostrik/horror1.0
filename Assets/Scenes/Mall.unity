--- !u!114 &6064
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6059}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 52f0b1ccf04d78775ada72c085992d6b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  order: 0
  title: "VHS: \u00AB\u041F\u0440\u043E\u043C\u043E\u0443\u0442\u0435\u0440-3000. \u0418\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044F\u00BB"
  prompt: "[E] \u041E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u043A\u0430\u0441\u0441\u0435\u0442\u0443"
  body: "\u041D\u0430\u043A\u043B\u0435\u0439\u043A\u0430 \u043D\u0430 \u043A\u0430\u0441\u0441\u0435\u0442\u0435. \u0414\u0430\u043B\u044C\u0448\u0435 \u2014 \u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043E\u0432\u043A\u0430 \u043F\u0435\u0440\u0432\u044B\u0445 \u043C\u0438\u043D\u0443\u0442 \u0437\u0430\u043F\u0438\u0441\u0438:\n\n\u00AB...\u043C\u043E\u0434\u0435\u043B\u044C \u043E\u0431\u0443\u0447\u0430\u0435\u0442\u0441\u044F \u043D\u0430 \u043F\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u0438 \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u0435\u043B\u0435\u0439. \u041E\u0441\u043D\u043E\u0432\u043D\u0430\u044F \u0437\u0430\u0434\u0430\u0447\u0430 \u2014 \u043D\u0435 \u0434\u0430\u0442\u044C \u043A\u043B\u0438\u0435\u043D\u0442\u0443 \u0443\u0439\u0442\u0438 \u0431\u0435\u0437 \u043F\u043E\u043A\u0443\u043F\u043A\u0438. \u041F\u0440\u0438 \u043F\u043E\u0442\u0435\u0440\u0435 \u043A\u043E\u043D\u0442\u0430\u043A\u0442\u0430 \u0441 \u043A\u043B\u0438\u0435\u043D\u0442\u043E\u043C \u043C\u043E\u0434\u0435\u043B\u044C \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442 \u0432 \u0440\u0435\u0436\u0438\u043C \u043F\u043E\u0438\u0441\u043A\u0430...\u00BB\n\n\u00AB...\u0412\u041D\u0418\u041C\u0410\u041D\u0418\u0415: \u043D\u0435 \u043E\u0442\u043A\u043B\u044E\u0447\u0430\u0439\u0442\u0435 \u043C\u043E\u0434\u0443\u043B\u044C \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0433\u043E \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043D\u0438\u044F...\u00BB\n\n\u041D\u0430 \u043A\u043E\u0440\u0435\u0448\u043A\u0435 \u043C\u0430\u0440\u043A\u0435\u0440\u043E\u043C: \u00AB\u041D\u0415 \u0414\u0401\u0420\u0413\u0410\u0419 \u0420\u0423\u0411\u0418\u041B\u042C\u041D\u0418\u041A, \u0415\u0421\u041B\u0418 \u041E\u041D \u0420\u042F\u0414\u041E\u041C. \u041E\u041D \u0418\u0414\u0401\u0422 \u041D\u0410 \u0417\u0412\u0423\u041A\u00BB"
