--- !u!114 &6214
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6209}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 52f0b1ccf04d78775ada72c085992d6b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  order: 0
  title: "\u0416\u0443\u0440\u043D\u0430\u043B \u044D\u043B\u0435\u043A\u0442\u0440\u0438\u043A\u0430"
  prompt: "[E] \u041F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C"
  body: "03.12 \u2014 \u043A\u0442\u043E-\u0442\u043E \u043F\u043E\u0432\u044B\u0434\u0451\u0440\u0433\u0438\u0432\u0430\u043B \u043F\u0440\u0435\u0434\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u0438 \u0438\u0437 \u0449\u0438\u0442\u043A\u0430 \u00AB\u041A\u043E\u0440\u0437\u0438\u043D\u044B\u00BB \u0438 \u0440\u0430\u0441\u043A\u0438\u0434\u0430\u043B \u043F\u043E \u0432\u0441\u0435\u043C\u0443 \u0422\u0426. \u041E\u0434\u0438\u043D \u043D\u0430\u0448\u0451\u043B \u0432 \u043F\u0438\u0446\u0446\u0435\u0440\u0438\u0438. \u041A\u043E\u043C\u0443 \u044D\u0442\u043E \u043D\u0430\u0434\u043E?\n\n04.12 \u2014 \u043D\u043E\u0447\u044C\u044E \u0449\u0438\u0442\u043E\u043A \u043A\u0442\u043E-\u0442\u043E \u0432\u043A\u043B\u044E\u0447\u0430\u043B. \u0414\u0430\u0442\u0447\u0438\u043A\u0438 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F \u0432 \u0437\u0430\u043B\u0435 \u0441\u0440\u0430\u0431\u043E\u0442\u0430\u043B\u0438 212 \u0440\u0430\u0437. \u041D\u0430 \u043A\u0430\u043C\u0435\u0440\u0430\u0445 \u043F\u0443\u0441\u0442\u043E \u2014 \u043F\u043E\u043C\u0435\u0445\u0438 \u0438 \u0443\u043B\u044B\u0431\u043A\u0430.\n\n05.12 \u2014 \u0431\u043E\u043B\u044C\u0448\u0435 \u0432 \u043D\u043E\u0447\u044C \u043D\u0435 \u0432\u044B\u0445\u043E\u0436\u0443. \u041F\u0443\u0441\u0442\u044C \u0441\u0430\u043C\u0438."
--- !u!33 &6219
