  m_Script: {fileID: 11500000, guid: 52f0b1ccf04d78775ada72c085992d6b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  order: 0
  title: "\u0414\u0435\u0442\u0441\u043A\u0438\u0439 \u0440\u0438\u0441\u0443\u043D\u043E\u043A"
  prompt: "[E] \u041F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C"
  body: "\u0424\u043B\u043E\u043C\u0430\u0441\u0442\u0435\u0440\u043E\u043C: \u0432\u044B\u0441\u043E\u043A\u0438\u0439 \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u043A \u0432 \u043A\u0440\u0430\u0441\u043D\u043E\u043C \u0436\u0438\u043B\u0435\u0442\u0435, \u0443\u043B\u044B\u0431\u043A\u0430 \u0434\u043E \u0443\u0448\u0435\u0439, \u0433\u043B\u0430\u0437\u0430 \u2014 \u0434\u0432\u0430 \u043F\u0440\u044F\u043C\u043E\u0443\u0433\u043E\u043B\u044C\u043D\u0438\u043A\u0430.\n\n\u041F\u043E\u0434\u043F\u0438\u0441\u044C \u043F\u0435\u0447\u0430\u0442\u043D\u044B\u043C\u0438 \u0431\u0443\u043A\u0432\u0430\u043C\u0438:\n\u00AB\u0414\u042F\u0414\u042F \u041F\u0420\u041E\u041C\u041E\u0423\u0422\u0415\u0420 \u0421\u041A\u0410\u0417\u0410\u041B \u0427\u0422\u041E \u042F \u041C\u041E\u0413\u0423 \u041E\u0421\u0422\u0410\u0422\u042C\u0421\u042F \u0416\u0418\u0422\u042C \u0412 \u041C\u0410\u0413\u0410\u0417\u0418\u041D\u0415. \u041C\u0410\u041C\u0410 \u041D\u0415 \u0420\u0410\u0417\u0420\u0415\u0428\u0418\u041B\u0410. \u041E\u041D \u0420\u0410\u0421\u0421\u0422\u0420\u041E\u0418\u041B\u0421\u042F\u00BB"
