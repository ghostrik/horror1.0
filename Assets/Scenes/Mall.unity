  menuScene: "MainMenu"
  introLines:
  - "\u0422\u0426 \u00AB\u0413\u0430\u043B\u0430\u043A\u0442\u0438\u043A\u0430\u00BB. \u0417\u0430\u043A\u0440\u044B\u0442 \u0448\u0435\u0441\u0442\u044C \u043B\u0435\u0442 \u043D\u0430\u0437\u0430\u0434."
  - "\u0420\u0435\u0431\u044F\u0442 \u044F \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u043B \u0434\u043E\u043C\u043E\u0439 \u0441\u0430\u043C. \u00AB\u041E\u0434\u043D\u043E\u043C\u0443 \u0431\u0443\u0434\u0435\u0442 \u0441\u0442\u0440\u0430\u0448\u043D\u0435\u0435 \u2014 \u0437\u0440\u0438\u0442\u0435\u043B\u044F\u043C \u0437\u0430\u0439\u0434\u0451\u0442\u00BB."
  - "\u0420\u0435\u0448\u0451\u0442\u043A\u0443 \u0437\u0430\u043A\u0440\u044B\u043B \u0438\u0437\u043D\u0443\u0442\u0440\u0438. \u0414\u043B\u044F \u0430\u043D\u0442\u0443\u0440\u0430\u0436\u0430."
  - "\u041D\u043E\u0447\u044C. 02:47. \u0417\u0430\u043F\u0438\u0441\u044C \u043F\u043E\u0448\u043B\u0430."
